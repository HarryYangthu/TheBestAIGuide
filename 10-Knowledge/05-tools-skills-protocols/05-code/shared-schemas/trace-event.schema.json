{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trace-event",
  "$comment": "TheBestAIGuide local contract v1; not an MCP or A2A wire format.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "seq",
    "kind",
    "data"
  ],
  "additionalProperties": false
}
